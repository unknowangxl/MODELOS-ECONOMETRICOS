EXPORT RmX:={};
EXPORT RmY:={};
EXPORT RmT:=1;
EXPORT RmXT:={};
EXPORT RmUT:={};
EXPORT RmRes:={};
EXPORT TapX:=0;
EXPORT TapY:=0;

EsperaTecla()
BEGIN
  LOCAL k,m,p,tocando,x,y,j,c;

  LOCAL kk;

  tocando:=0; x:=0; y:=0;
  kk:={2,12,30,4};
  REPEAT
    FOR j FROM 1 TO 4 DO
      c:=kk(j);
      IF ISKEYDOWN(c) THEN
        REPEAT
          WAIT(0.02);
        UNTIL NOT ISKEYDOWN(c);
        RETURN c;
      END;
    END;
    m:=MOUSE;
    p:={};
    IF TYPE(m)==6 THEN
      IF SIZE(m)>0 THEN p:=m(1); END;
    END;
    IF TYPE(p)==6 AND SIZE(p)>=2 THEN
      x:=p(1); y:=p(2);
      tocando:=1;
    ELSE
      IF tocando==1 THEN
        TapX:=x; TapY:=y;
        RETURN 1000;
      END;
    END;
  UNTIL 0;
END;

Fm(x,d)
BEGIN
  RETURN STRING(ROUND(x,d));
END;

Cabecera(t,c,f)
BEGIN
  RECT_P(G1,0,0,319,27,c,c);
  TEXTOUT_P(t,G1,8,5,f,RGB(0,0,0));
END;

Pie(t)
BEGIN
  RECT_P(G1,0,219,319,239,RGB(30,40,80),RGB(30,40,80));
  TEXTOUT_P(t,G1,6,223,4,RGB(200,220,255));
END;

PieNav(a,b,c)
BEGIN
  RECT_P(G1,0,219,105,239,RGB(255,255,255),RGB(30,40,80));
  RECT_P(G1,107,219,212,239,RGB(255,255,255),RGB(120,30,30));
  RECT_P(G1,214,219,319,239,RGB(255,255,255),RGB(30,40,80));
  TEXTOUT_P(a,G1,16,222,4,RGB(255,255,255));
  TEXTOUT_P(b,G1,120,222,4,RGB(255,255,255));
  TEXTOUT_P(c,G1,230,222,4,RGB(255,255,255));
END;

Aviso(t)
BEGIN
  LOCAL k;

  RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
  Cabecera("AVISO",RGB(255,60,60),4);
  RECT_P(G1,10,70,309,150,RGB(255,60,60),RGB(16,28,64));
  TEXTOUT_P(t,G1,18,100,4,RGB(255,255,255));
  Pie("Toca la pantalla o pulsa una tecla");
  BLIT_P(G0,G1);
  k:=EsperaTecla();
END;

Preset(p)
BEGIN
  IF p==1 THEN
    RmX:={1,1.1,1.2,1.3,1.4,1.5,1.6,1.7,1.8,1.9,2};
    RmY:={8.1,7.8,8.5,9.8,9.5,8.9,8.6,10.2,9.3,9.2,10.5};
  END;
  IF p==2 THEN
    RmX:={2,2,4,4,6,6,8,9,9,11,11,11};
    RmY:={0.8,2,2.6,3,3,4,8.1,6,7,9,10.2,10.9};
  END;
  IF p==3 THEN
    RmX:={10,10,20,20,20,30,40,40,50,60,60,70,70,70,80};
    RmY:={75,70,45,50,40,35,20,25,20,15,10,15,15,20,15};
  END;
  IF p==4 THEN
    RmX:={700,700,800,800,800,900,900,1000,1000,1000,1000,1100,1100,1200,1200,1300,1300,1400,1400,1400,1400,1400,1500,1500,1500,1600,1600,1600,1600,1600};
    RmY:={160,200,140,160,200,155,220,160,180,220,250,180,220,325,360,310,350,470,400,540,560,600,940,820,850,1200,1040,1150,1060,1100};
  END;
  IF p==5 THEN
    RmX:={57,59,49,62,51,50,55,48,42,42,61,57};
    RmY:={64,71,53,67,55,58,77,57,56,51,76,68};
  END;
END;

RmGuardaT(xt,ut)
BEGIN
  RmXT:=xt;
  RmUT:=ut;
END;

RmGuardaR(rs)
BEGIN
  RmRes:=rs;
END;

RmSumas()
BEGIN
  LOCAL mt;

  LOCAL i,n,x,u,sx,su,sxx,suu;

  LOCAL sxu,xs,ys,xt,ut,r;

  mt:=RmT;
  xs:=RmX; ys:=RmY;
  n:=SIZE(xs);
  xt:=MAKELIST(0,K,1,n);
  ut:=MAKELIST(0,K,1,n);
  sx:=0; su:=0; sxx:=0; suu:=0; sxu:=0;
  FOR i FROM 1 TO n DO
    x:=xs(i); u:=ys(i);
    IF mt==3 THEN x:=LN(x); END;
    IF mt>1 THEN u:=LN(u); END;
    xt(i):=x; ut(i):=u;
    sx:=sx+x; su:=su+u;
    sxx:=sxx+x*x; suu:=suu+u*u; sxu:=sxu+x*u;
  END;
  RmGuardaT(xt,ut);
  r:=MAKELIST(0,K,1,6);
  r(1):=n; r(2):=sx; r(3):=su;
  r(4):=sxx; r(5):=suu; r(6):=sxu;
  RETURN r;
END;

RmFinal(s)
BEGIN
  LOCAL mt;

  LOCAL n,sx,su,cxx,cuu,cxu,b1,al;

  LOCAL b0,rs;

  mt:=RmT;
  n:=s(1); sx:=s(2); su:=s(3);
  cxx:=s(4)-sx*sx/n;
  cuu:=s(5)-su*su/n;
  cxu:=s(6)-sx*su/n;
  b1:=0;
  IF cxx<>0 THEN b1:=cxu/cxx; END;
  al:=su/n-b1*sx/n;
  b0:=al;
  IF mt>1 THEN b0:=EXP(al); END;
  rs:=MAKELIST(0,K,1,12);
  rs(1):=n; rs(2):=sx; rs(3):=su;
  rs(4):=s(4); rs(5):=s(5); rs(6):=s(6);
  rs(7):=cxx; rs(8):=cuu; rs(9):=cxu;
  rs(10):=b1; rs(11):=al; rs(12):=b0;
  RmGuardaR(rs);
END;

RmCalc()
BEGIN
  LOCAL s;

  s:=RmSumas();
  RmFinal(s);
END;

Elige(tit,subt,items,col)
BEGIN
  LOCAL s,n,k,fin,i,y,x,r;

  n:=SIZE(items); s:=1; fin:=0; r:=0;
  REPEAT
    RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
    Cabecera(tit,col,4);
    TEXTOUT_P(subt,G1,8,32,4,RGB(255,215,0));
    FOR i FROM 1 TO n DO
      y:=54+(i-1)*32;
      IF i==s THEN
        RECT_P(G1,4,y,315,y+28,RGB(255,255,255),col);
        TEXTOUT_P(items(i),G1,10,y+6,4,RGB(0,0,0));
      ELSE
        RECT_P(G1,4,y,315,y+28,RGB(50,60,100),RGB(16,28,64));
        TEXTOUT_P(items(i),G1,10,y+6,4,RGB(255,255,255));
      END;
    END;
    Pie("Toca una opcion  |  ESC: volver");
    BLIT_P(G0,G1);
    k:=EsperaTecla();
    IF k==2 THEN s:=s-1; IF s<1 THEN s:=n; END; END;
    IF k==12 THEN s:=s+1; IF s>n THEN s:=1; END; END;
    IF k==30 THEN r:=s; fin:=1; END;
    IF k==4 THEN r:=0; fin:=1; END;
    IF k==1000 THEN
      y:=TapY;
      IF y>=219 THEN
        r:=0; fin:=1;
      ELSE
        i:=IP((y-54)/32)+1;
        IF y>=54 AND i>=1 AND i<=n THEN r:=i; fin:=1; END;
      END;
    END;
  UNTIL fin=1;
  RETURN r;
END;

Etiquetas()
BEGIN
  LOCAL mt;

  LOCAL vx,vy;

  mt:=RmT;
  vx:="X"; vy:="Y";
  IF mt==3 THEN vx:="V==lnX"; END;
  IF mt>1 THEN vy:="U==lnY"; END;
  RETURN {vx,vy};
END;

RmTabla()
BEGIN
  LOCAL mt;

  LOCAL top,n,k,fin,i,idx,y,cx;

  LOCAL et,hd,v,ru,rx,col,x1,rr;

  LOCAL xt,ut;

  mt:=RmT;
  rr:=RmRes; xt:=RmXT; ut:=RmUT;
  n:=rr(1); top:=1; fin:=0;
  et:=Etiquetas();
  hd:={"i",et(1),et(2),"XY","X²","Y²"};
  cx:={0,30,92,154,216,268,319};
  REPEAT
    RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
    IF mt==1 THEN Cabecera("TABLA DE DATOS  (modelo lineal)",RGB(255,215,0),5); END;
    IF mt==2 THEN Cabecera("TABLA DE DATOS  (exponencial)",RGB(255,215,0),5); END;
    IF mt==3 THEN Cabecera("TABLA DE DATOS  (potencial)",RGB(255,215,0),5); END;
    FOR i FROM 1 TO 6 DO
      IF i<4 THEN col:=RGB(0,150,70); ELSE col:=RGB(200,30,30); END;
      RECT_P(G1,cx(i),30,cx(i+1)-1,48,RGB(255,255,255),col);
      TEXTOUT_P(hd(i),G1,cx(i)+3,34,4,RGB(255,255,255));
    END;
    FOR i FROM 1 TO 8 DO
      idx:=top+i-1;
      IF idx<=n THEN
        y:=50+(i-1)*17;
        rx:=xt(idx); ru:=ut(idx);
        v:={STRING(idx),Fm(rx,4),Fm(ru,4),Fm(rx*ru,3),Fm(rx*rx,3),Fm(ru*ru,3)};
        FOR k FROM 1 TO 6 DO
          IF k<4 THEN col:=RGB(20,50,120); ELSE col:=RGB(16,28,64); END;
          RECT_P(G1,cx(k),y,cx(k+1)-1,y+16,RGB(70,80,120),col);
          TEXTOUT_P(v(k),G1,cx(k)+3,y+3,4,RGB(255,255,255));
        END;
      END;
    END;
    v:={"Σ",Fm(rr(2),3),Fm(rr(3),3),Fm(rr(6),3),Fm(rr(4),3),Fm(rr(5),3)};
    FOR k FROM 1 TO 6 DO
      RECT_P(G1,cx(k),188,cx(k+1)-1,205,RGB(0,0,0),RGB(255,215,0));
      TEXTOUT_P(v(k),G1,cx(k)+3,192,4,RGB(0,0,0));
    END;
    TEXTOUT_P("n = "+STRING(n)+"    filas "+STRING(top)+"-"+STRING(MIN(top+7,n)),G1,6,207,4,RGB(0,230,255));
    PieNav("SUBIR","VOLVER","BAJAR");
    BLIT_P(G0,G1);
    k:=EsperaTecla();
    IF k==2 THEN top:=MAX(1,top-1); END;
    IF k==12 THEN top:=MIN(MAX(1,n-7),top+1); END;
    IF k==4 THEN fin:=1; END;
    IF k==1000 THEN
      IF TapY>=219 THEN
        IF TapX<107 THEN top:=MAX(1,top-4); END;
        IF TapX>=107 AND TapX<214 THEN fin:=1; END;
        IF TapX>=214 THEN top:=MIN(MAX(1,n-7),top+4); END;
      END;
    END;
  UNTIL fin=1;
END;

RmSol()
BEGIN
  LOCAL mt;

  LOCAL L,C,i,et,vx,vy,n,k;

  LOCAL y,rr;

  mt:=RmT;
  rr:=RmRes;
  et:=Etiquetas(); vx:=et(1); vy:=et(2); n:=rr(1);
  IF mt==1 THEN vx:="X"; vy:="Y"; END;
  L:=MAKELIST("",K,1,10);
  L(1):="n="+STRING(n)+"   Σ"+vx+"="+Fm(rr(2),4)+"   Σ"+vy+"="+Fm(rr(3),4);
  L(2):="Σ"+vx+"²="+Fm(rr(4),4)+"   Σ"+vy+"²="+Fm(rr(5),4);
  L(3):="Σ"+vx+vy+"="+Fm(rr(6),4);
  L(4):="Sxx="+Fm(rr(4),3)+"-"+Fm(rr(2),3)+"²/"+STRING(n)+"="+Fm(rr(7),4);
  L(5):="Syy="+Fm(rr(5),3)+"-"+Fm(rr(3),3)+"²/"+STRING(n)+"="+Fm(rr(8),4);
  L(6):="Sxy="+Fm(rr(6),3)+"-"+Fm(rr(2),3)+"("+Fm(rr(3),3)+")/"+STRING(n)+"="+Fm(rr(9),4);
  L(7):="b1=Sxy/Sxx="+Fm(rr(9),4)+"/"+Fm(rr(7),4)+"="+Fm(rr(10),5);
  IF mt==1 THEN
    L(8):="b0="+Fm(rr(3)/n,4)+"-"+Fm(rr(10),4)+"("+Fm(rr(2)/n,4)+")="+Fm(rr(11),5);
    L(9):="Yest = "+Fm(rr(11),4)+" + "+Fm(rr(10),4)+" X";
  ELSE
    L(8):="Ln b0="+Fm(rr(3)/n,4)+"-"+Fm(rr(10),4)+"("+Fm(rr(2)/n,4)+")="+Fm(rr(11),5);
    IF mt==2 THEN
      L(9):="Yest = "+Fm(rr(12),4)+" e^("+Fm(rr(10),4)+" X)";
    ELSE
      L(9):="Yest = "+Fm(rr(12),3)+" X^("+Fm(rr(10),4)+")";
    END;
  END;
  L(10):="R² = SSR/SST = "+Fm(rr(10)*rr(9),4)+"/"+Fm(rr(8),4)+" = "+Fm(IFTE(rr(8)==0,0,rr(10)*rr(9)/rr(8)),4);
  C:={RGB(0,230,255),RGB(0,230,255),RGB(0,230,255),RGB(255,255,255),RGB(255,255,255),RGB(255,255,255),RGB(255,255,255),RGB(255,255,255),RGB(80,255,120),RGB(255,215,0)};
  RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
  IF mt==1 THEN Cabecera("ESTIMACION  mu==b0+b1x",RGB(255,215,0),5); END;
  IF mt==2 THEN Cabecera("ESTIMACION  mu==b0*e^(b1x)",RGB(255,215,0),5); END;
  IF mt==3 THEN Cabecera("ESTIMACION  mu==b0*x^b1",RGB(255,215,0),5); END;
  FOR i FROM 1 TO 10 DO
    TEXTOUT_P(L(i),G1,6,32+(i-1)*18,6,C(i));
  END;
  Pie("Toca la pantalla o pulsa una tecla: volver");
  BLIT_P(G0,G1);
  k:=EsperaTecla();
END;


EXPORT RmAlpha:=0.05;
EXPORT RmX0:=0;

RmMuestraValida()
BEGIN
  LOCAL n,rr,ok;
  n:=SIZE(RmX);
  IF n<3 OR SIZE(RmY)<>n THEN RETURN 0; END;
  ok:=1;
  IF RmT>1 THEN IF MIN(RmY)<=0 THEN ok:=0; END; END;
  IF RmT==3 THEN IF MIN(RmX)<=0 THEN ok:=0; END; END;
  IF ok==0 THEN RETURN 0; END;
  RmCalc();
  rr:=RmRes;
  IF SIZE(rr)<12 OR rr(7)<=0 THEN RETURN 0; END;
  RETURN 1;
END;

RmVer(tit,ls)
BEGIN
  LOCAL i,k,y;
  RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
  Cabecera(tit,RGB(255,215,0),4);
  FOR i FROM 1 TO SIZE(ls) DO
    y:=34+(i-1)*19;
    IF y<211 THEN TEXTOUT_P(ls(i),G1,7,y,4,RGB(235,245,255)); END;
  END;
  Pie("ENTER / ESC: volver");
  BLIT_P(G0,G1);
  k:=EsperaTecla();
END;

RmCapturaX0()
BEGIN
  LOCAL buf,k,i,j,x,y,celda,valor;
  buf:="0";
  REPEAT
    RECT_P(G1,0,0,319,239,RGB(8,16,40),RGB(8,16,40));
    Cabecera("PREDICCION: INGRESAR X0",RGB(255,215,0),4);
    TEXTOUT_P("X0 = "+buf,G1,12,34,4,RGB(0,230,255));
    FOR i FROM 1 TO 5 DO
      FOR j FROM 1 TO 3 DO
        x:=8+(j-1)*104; y:=57+(i-1)*31; celda:="";
        IF i==1 THEN celda:=STRING(j+6); END;
        IF i==2 THEN celda:=STRING(j+3); END;
        IF i==3 THEN celda:=STRING(j); END;
        IF i==4 AND j==1 THEN celda:="-"; END;
        IF i==4 AND j==2 THEN celda:="."; END;
        IF i==4 AND j==3 THEN celda:="0"; END;
        IF i==5 AND j==1 THEN celda:="BORRAR"; END;
        IF i==5 AND j==2 THEN celda:="OK"; END;
        IF celda<>"" THEN
          RECT_P(G1,x,y,x+96,y+27,RGB(120,150,210),RGB(35,55,100));
          TEXTOUT_P(celda,G1,x+27,y+7,4,RGB(255,255,255));
        END;
      END;
    END;
    Pie("Toca los numeros para ingresar X0");
    BLIT_P(G0,G1);
    k:=EsperaTecla();
    IF k==4 THEN RETURN 0; END;
    IF k==1000 THEN
      x:=TapX; y:=TapY;
      IF y>=57 AND y<212 THEN
        i:=IP((y-57)/31)+1; j:=IP(x/104)+1; celda:="";
        IF i==1 AND j>=1 AND j<=3 THEN celda:=STRING(j+6); END;
        IF i==2 AND j>=1 AND j<=3 THEN celda:=STRING(j+3); END;
        IF i==3 AND j>=1 AND j<=3 THEN celda:=STRING(j); END;
        IF i==4 AND j==1 THEN celda:="-"; END;
        IF i==4 AND j==2 THEN celda:="."; END;
        IF i==4 AND j==3 THEN celda:="0"; END;
        IF i==5 AND j==1 THEN
          IF SIZE(buf)>1 THEN buf:=LEFT(buf,SIZE(buf)-1); ELSE buf:="0"; END;
        END;
        IF i==5 AND j==2 THEN
          valor:=EXPR(buf); RmX0:=valor; RETURN 1;
        END;
        IF celda<>"" THEN
          IF celda=="-" THEN
            IF LEFT(buf,1)=="-" THEN buf:=RIGHT(buf,SIZE(buf)-1); ELSE buf:="-"+buf; END;
          ELSE
            IF celda=="." THEN
              IF INSTRING(buf,".")==0 THEN buf:=buf+"."; END;
            ELSE
              IF buf=="0" THEN buf:=celda; ELSE buf:=buf+celda; END;
            END;
          END;
        END;
      END;
    END;
  UNTIL 0;
END;

EXPORT RmICB0()
BEGIN
  LOCAL rr,n,xm,s2,se,tc,lo,hi,df;
  IF RmMuestraValida()==0 THEN Aviso("Primero estima el modelo con al menos 3 datos"); RETURN; END;
  IF RmT<>1 THEN Aviso("El IC para beta0 requiere modelo lineal"); RETURN; END;
  rr:=RmRes; n:=rr(1); df:=n-2; xm:=rr(2)/n;
  s2:=(rr(8)-rr(10)*rr(9))/df; IF s2<0 THEN s2:=0; END;
  se:=SQRT(s2*(1/n+xm^2/rr(7)));
  tc:=STUDENT_ICDF(df,1-RmAlpha/2); lo:=rr(11)-tc*se; hi:=rr(11)+tc*se;
  RmVer("1.1 IC PARA BETA0",{
    "Confianza = "+Fm(100*(1-RmAlpha),1)+"%",
    "n = "+STRING(n)+"   gl = n-2 = "+STRING(df),
    "x media = "+Fm(xm,5)+"   Sxx = "+Fm(rr(7),5),
    "SSE = "+Fm(rr(8)-rr(10)*rr(9),5),
    "s = raiz(SSE/gl) = "+Fm(SQRT(s2),5),
    "EE(b0) = s*raiz(1/n+xmedia^2/Sxx)",
    "EE(b0) = "+Fm(se,5),
    "t critico = "+Fm(tc,5),
    "b0 estimado = "+Fm(rr(11),5),
    "IC beta0 = ["+Fm(lo,5)+" ; "+Fm(hi,5)+"]"
  });
END;

EXPORT RmICB1()
BEGIN
  LOCAL rr,n,s2,se,tc,lo,hi,df,b1;
  IF RmMuestraValida()==0 THEN Aviso("Primero estima el modelo con al menos 3 datos"); RETURN; END;
  IF RmT<>1 THEN Aviso("El IC para beta1 requiere modelo lineal"); RETURN; END;
  rr:=RmRes; n:=rr(1); df:=n-2; b1:=rr(10);
  s2:=(rr(8)-rr(10)*rr(9))/df; IF s2<0 THEN s2:=0; END;
  se:=SQRT(s2/rr(7)); tc:=STUDENT_ICDF(df,1-RmAlpha/2);
  lo:=b1-tc*se; hi:=b1+tc*se;
  RmVer("1.2 IC PARA BETA1",{
    "Confianza = "+Fm(100*(1-RmAlpha),1)+"%",
    "n = "+STRING(n)+"   gl = n-2 = "+STRING(df),
    "Sxx = "+Fm(rr(7),5)+"   SSE = "+Fm(rr(8)-rr(10)*rr(9),5),
    "s = raiz(SSE/gl) = "+Fm(SQRT(s2),5),
    "EE(b1) = s/raiz(Sxx) = "+Fm(se,5),
    "t critico = "+Fm(tc,5),
    "b1 estimado = "+Fm(b1,5),
    "Margen = t*EE(b1) = "+Fm(tc*se,5),
    "IC beta1 = ["+Fm(lo,5)+" ; "+Fm(hi,5)+"]"
  });
END;

EXPORT RmPredice()
BEGIN
  LOCAL rr,n,df,xm,s2,se1,se2,tc,yp,lo1,hi1,lo2,hi2,x0;
  IF RmMuestraValida()==0 THEN Aviso("Primero estima el modelo con al menos 3 datos"); RETURN; END;
  IF RmT<>1 THEN Aviso("La prediccion por intervalos requiere modelo lineal"); RETURN; END;
  IF RmCapturaX0()==0 THEN RETURN; END;
  rr:=RmRes; n:=rr(1); df:=n-2; xm:=rr(2)/n; x0:=RmX0;
  s2:=(rr(8)-rr(10)*rr(9))/df; IF s2<0 THEN s2:=0; END;
  tc:=STUDENT_ICDF(df,1-RmAlpha/2); yp:=rr(11)+rr(10)*x0;
  se1:=SQRT(s2*(1/n+(x0-xm)^2/rr(7)));
  se2:=SQRT(s2*(1+1/n+(x0-xm)^2/rr(7)));
  lo1:=yp-tc*se1; hi1:=yp+tc*se1; lo2:=yp-tc*se2; hi2:=yp+tc*se2;
  RmVer("1.3 PREDICCION",{
    "X0 = "+Fm(x0,5)+"   x media = "+Fm(xm,5),
    "Rango X: ["+Fm(MIN(RmX),4)+" ; "+Fm(MAX(RmX),4)+"]",
    "Tipo: "+IFTE(x0<MIN(RmX) OR x0>MAX(RmX),"EXTRAPOLACION","INTERPOLACION"),
    "Y estimado = b0+b1*X0 = "+Fm(yp,5),
    "t critico (gl="+STRING(df)+") = "+Fm(tc,5),
    "IC para la media:",
    "["+Fm(lo1,5)+" ; "+Fm(hi1,5)+"]",
    "Intervalo prediccion individual:",
    "["+Fm(lo2,5)+" ; "+Fm(hi2,5)+"]"
  });
END;

EXPORT RmUtilT()
BEGIN
  LOCAL rr,n,df,s2,se,tv,tc,pv,dec,b1;
  IF RmMuestraValida()==0 THEN Aviso("Primero estima el modelo con al menos 3 datos"); RETURN; END;
  IF RmT<>1 THEN Aviso("La prueba T requiere modelo lineal"); RETURN; END;
  rr:=RmRes; n:=rr(1); df:=n-2; b1:=rr(10);
  s2:=(rr(8)-rr(10)*rr(9))/df; IF s2<0 THEN s2:=0; END;
  se:=SQRT(s2/rr(7));
  IF se==0 THEN Aviso("Error estandar nulo: no se calcula T"); RETURN; END;
  tv:=b1/se; tc:=STUDENT_ICDF(df,1-RmAlpha/2);
  pv:=2*(1-STUDENT_CDF(df,ABS(tv))); dec:=ABS(tv)>tc;
  RmVer("1.4 UTILIDAD DEL MODELO: T",{
    "H0: beta1 = 0",
    "H1: beta1 <> 0",
    "Alfa = "+Fm(RmAlpha,3)+"   gl = "+STRING(df),
    "EE(b1) = "+Fm(se,5),
    "T calculado = b1/EE(b1) = "+Fm(tv,5),
    "T critico bilateral = +/- "+Fm(tc,5),
    "p-valor = "+Fm(pv,6),
    "Rechazar H0 si |Tcalc| > Tcrit",
    IFTE(dec,"Se rechaza H0: modelo UTIL","No se rechaza H0: sin evidencia de utilidad")
  });
END;


EXPORT RmDATOS()
BEGIN
  LOCAL op,fin,r,t,subt,ok;

  LOCAL mt,xs,ys;

  xs:=RmX;
  IF TYPE(xs)<>6 THEN Preset(1); RmT:=1; END;
  DIMGROB_P(G1,320,240,RGB(8,16,40));
  fin:=0;
  REPEAT
    mt:=RmT; xs:=RmX; ys:=RmY;
    t:="lineal";
    IF mt==2 THEN t:="exponencial"; END;
    IF mt==3 THEN t:="potencial"; END;
    subt:="n="+STRING(SIZE(xs))+"   modelo: "+t;
    op:=Elige("MODULO 1: DATOS Y MODELO",subt,{"1 Ejemplo del libro","2 Leer listas L1 y L2","3 Elegir modelo","4 Tabla de datos","5 Solucion paso a paso"},RGB(255,80,80));
    IF op==0 THEN fin:=1; END;
    IF op==1 THEN
      r:=Elige("EJEMPLOS DEL LIBRO","Elige la muestra",{"Ej.1 (n=11)","Ej.4/5 (n=12)","Ej.6 Oruro (n=15)","Prop.1 Ahorro (n=30)","Prop.2 (n=12)"},RGB(255,80,80));
      IF r>0 THEN Preset(r); END;
    END;
    IF op==2 THEN
      IF TYPE(L1)==6 AND TYPE(L2)==6 THEN
        IF SIZE(L1)==SIZE(L2) AND SIZE(L1)>2 THEN
          RmX:=L1; RmY:=L2;
        ELSE
          Aviso("L1 y L2 deben tener igual tamano (>2)");
        END;
      ELSE
        Aviso("Llena las listas L1 (X) y L2 (Y)");
      END;
    END;
    IF op==3 THEN
      r:=Elige("MODELO A ESTIMAR","Elige la forma del modelo",{"Lineal  y=b0+b1x","Exponencial  y=b0*e^(b1x)","Potencial  y=b0*x^b1"},RGB(255,80,80));
      IF r>0 THEN RmT:=r; END;
    END;
    IF op==4 OR op==5 THEN
      ok:=1;
      IF mt>1 THEN IF MIN(ys)<=0 THEN ok:=0; END; END;
      IF mt==3 THEN IF MIN(xs)<=0 THEN ok:=0; END; END;
      IF ok==0 THEN
        Aviso("Para este modelo los datos deben ser > 0");
      ELSE
        RmCalc();
        IF op==4 THEN RmTabla(); ELSE RmSol(); END;
      END;
    END;
  UNTIL fin=1;
END;
